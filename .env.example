# Copy this file to .env.local (Vite auto-loads .env.local, it's gitignored)
# and fill in your Supabase project's values: Project Settings -> API.

# Required for the Supabase-backed data/auth layer (src/lib/supabase/client.ts).
# Until both are set, isSupabaseConfigured is false and the app continues to
# run entirely on localStorage, unaffected.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
